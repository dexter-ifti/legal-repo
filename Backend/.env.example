# Express Backend Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL / Supabase - TASK-004)
# Generic PostgreSQL connection string (Works with Supabase, AWS RDS, Neon, or local Postgres)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
# Direct database URL used for schema migrations when using connection poolers (e.g. Supabase PgBouncer)
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Storage Configuration (Private Object Storage - Milestone 3 / TASK-011)
STORAGE_PROVIDER=local
STORAGE_BUCKET=legal-documents-dev

# Security Secrets
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production

# Authentication Provider Configuration (Supabase Auth - TASK-005)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
