# Root Environment Variables for VPS Deployment (Supabase DB & Storage + Nginx Proxy)

# Node Environment
NODE_ENV=production
PORT=5000

# Public URLs (Replace localhost with your domain or VPS IP)
# NEXT_PUBLIC_API_URL must be the API origin/base ONLY — no trailing /api path.
# The frontend appends /api/v1/... to this value itself.
NEXT_PUBLIC_API_URL=http://localhost
# Frontend origin used to build invite links (no trailing slash).
# Required for the invite feature; never hardcode this in code.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost
CORS_ORIGIN=http://localhost

# Supabase Database Connection
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Storage & Authentication (cloud-only object storage; local disk storage is not supported)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STORAGE_BUCKET=legal-documents

# Optional AI Key
MISTRAL_API_KEY=your-mistral-api-key

# Number of leading pages to OCR per document (default: 2)
# Legal documents carry identifying metadata in the opening pages.
OCR_MAX_PAGES=2

# Optional Outbound HTTP/HTTPS Proxy (if VPS requires proxy for external requests)
# HTTP_PROXY=http://proxy.vps.com:8080
# HTTPS_PROXY=http://proxy.vps.com:8080
# NO_PROXY=localhost,127.0.0.1,backend,frontend,db
