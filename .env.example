# Root Environment Variables for VPS Deployment (Supabase DB & Storage + Nginx Proxy)

# Node Environment
NODE_ENV=production
PORT=5000

# Public URLs (Replace localhost with your domain or VPS IP)
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_APP_URL=http://localhost
CORS_ORIGIN=http://localhost

# Supabase Database Connection
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Storage & Authentication
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=legal-documents
SUPABASE_S3_ENDPOINT=https://[PROJECT-REF].storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1

# Optional AI Key
MISTRAL_API_KEY=your-mistral-api-key

# Optional Outbound HTTP/HTTPS Proxy (if VPS requires proxy for external requests)
# HTTP_PROXY=http://proxy.vps.com:8080
# HTTPS_PROXY=http://proxy.vps.com:8080
# NO_PROXY=localhost,127.0.0.1,backend,frontend,db
